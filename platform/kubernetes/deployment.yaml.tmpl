apiVersion: apps/v1
kind: Deployment
metadata:
  name: manager-demo
  namespace: manager-demo
  labels:
    app.kubernetes.io/name: manager-demo
spec:
  replicas: 2
  revisionHistoryLimit: 3
  selector:
    matchLabels:
      app.kubernetes.io/name: manager-demo
  template:
    metadata:
      labels:
        app.kubernetes.io/name: manager-demo
    spec:
      containers:
        - name: api
          image: ${IMAGE_REF}
          imagePullPolicy: IfNotPresent
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: manager-demo-db
                  key: database-url
          ports:
            - containerPort: 8000
              name: http
          readinessProbe:
            httpGet:
              path: /health/ready
              port: http
            initialDelaySeconds: 2
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /health/live
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 3
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 512Mi
